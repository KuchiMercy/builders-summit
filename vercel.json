{
  "rewrites": [
    {
      "source": "/((?!api/|node_modules/|src/|@.*|vite/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/test-email",
      "schedule": "57 9 14 3 *"
    }
  ]
}