# ------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite + Firebase Client)
# Get these from Firebase Console -> Project Settings -> General
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------
# BACKEND CONFIGURATION (Vercel Functions + Firebase Admin)
# Get these from Firebase Console -> Project Settings -> Service Accounts
# Generate a NEW private key to get the JSON file.
# ------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# IMPORTANT: The private key must handle newlines correctly. 
# If pasting into Vercel Dashboard, just paste the whole string including \n
# If in local .env, wrap in quotes: "-----BEGIN PRIVATE KEY-----\n..."v
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------
# EMAIL SERVICE (Resend)
# Get API Key from https://resend.com/api-keys
# ------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=admin@example.com
FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------
# SECURITY (Cron Jobs)
# Generate a random string to protect your cron endpoint
# Example: https://generate-secret.vercel.app/32
# ------------------------------------------------------------------
CRON_SECRET=1cd6a3ad9f8b835a9ba096290fc149f1a620bd9eab7d6efc2f2e2b96ed589a52

# ------------------------------------------------------------------
# GOOGLE ANALYTICS 4
# ------------------------------------------------------------------
# Frontend Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=your_measurement_id
# Backend Property ID (e.g. 123456789)
GA_PROPERTY_ID=your_property_id
# Service Account for GA Data API
GA_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
